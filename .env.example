# Without a URL the site shows clearly labeled demonstration data.
SOCK_CONTROL_URL=
# Mismo secreto privado en ecommerce y SockControl (mínimo 32 caracteres).
# Firmar identidad anónima para límites por visitante; nunca NEXT_PUBLIC.
STOREFRONT_RATE_LIMIT_SECRET=
# Server-only exact host -> tenant map. No https://, path or wildcard.
# Replace TENANT_REAL with the tenant that owns the production inventory.
# Required in production. Unknown hosts are rejected (also with mocks).
# In development, leaving this empty allows only localhost:3000,
# 127.0.0.1:3000 and [::1]:3000 -> tienda-local.
STOREFRONT_DOMAIN_TENANTS=
# Render example (paste JSON without surrounding single quotes in its UI):
# {"tienda.merlyncilias.com":"TENANT_REAL","merlyncilias.com":"TENANT_REAL"}
# Public storefront endpoints do not require a token.
STOREFRONT_PRODUCTS_MOCK=false
STOREFRONT_BUNDLES_MOCK=false
# Optional bundle filter, e.g. 1,2,3. Empty shows all available public bundles.
STOREFRONT_BUNDLE_IDS=
# Business WhatsApp number including country code; digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=
